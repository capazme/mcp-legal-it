{
  "manifest_version": "0.4",
  "name": "mcp-legal-it",
  "display_name": "Legal IT — Diritto Italiano",
  "version": "3.0.0",
  "description": "234 tool di calcolo legale italiano, normativa (Normattiva/EUR-Lex/Gazzetta Ufficiale), giurisprudenza (Cassazione, Corte Costituzionale, CeRDEF tributario, TAR/CdS, CGUE, Corte dei conti), orientamenti, recepimento UE→IT, verifica citazioni, delibere CONSOB e compliance GDPR.",
  "author": {
    "name": "capazme",
    "url": "https://github.com/capazme"
  },
  "server": {
    "type": "uv",
    "entry_point": "mcp_legal_it/__main__.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "python",
        "-m",
        "mcp_legal_it"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ],
    "runtimes": {
      "python": ">=3.11"
    }
  },
  "keywords": [
    "legal",
    "italian-law",
    "GDPR",
    "normattiva",
    "cassazione",
    "avvocato"
  ],
  "license": "MPL-2.0"
}
