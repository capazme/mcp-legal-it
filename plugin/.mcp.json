{
  "mcpServers": {
    "legal-it": {
      "command": "uv",
      "args": [
        "run",
        "--python", "3.12",
        "--with", "fastmcp>=2.0,<4",
        "--with", "httpx>=0.27",
        "--with", "beautifulsoup4>=4.12",
        "--with", "lxml>=5.0",
        "--with", "fpdf2>=2.7",
        "--with", "python-docx>=1.0",
        "${CLAUDE_PLUGIN_ROOT}/server/run_server.py"
      ]
    }
  }
}
