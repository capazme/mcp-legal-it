*.secret
credentials.json

# Real firm/client data for the procure-quotazioni skill: counsel names, fiscal
# codes, PEC addresses. The skill tells the user to place this in the working
# directory, which may be this repo. The bundled example
# (content/skills/procure-quotazioni/references/studio.esempio.json) has a
# different filename and stays tracked.
studio.json

# AKN benchmark run artifacts (regenerated by benchmarks/akn_vs_html.py)
benchmarks/*_results.json
benchmarks/_*

# AKN fixtures used only by the live benchmark, not the unit tests (large).
# Capture them locally with the benchmark corpus if needed.
tests/fixtures/akn/dlgs_152_2006.xml
tests/fixtures/akn/dlgs_196_2003.xml

# uv ephemeral lock (uv run --with)
uv.lock

# Local Claude Code server config. This used to be tracked, carrying the
# author's absolute paths (/Users/<author>/...) into every clone: broken for
# everyone else, and a nested config a third party is asked to approve on
# trust. Copy .mcp.json.example instead — it resolves paths from the checkout.
.mcp.json
