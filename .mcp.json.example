{
  "_comment": [
    "Copy to .mcp.json (git-ignored) to run the server from this checkout.",
    "Paths resolve from the repository, so nothing here is machine-specific.",
    "Same launcher as the plugin: the versions pinned in plugin/server/uv.lock,",
    "in plugin/server/.venv. Drop the LEGAL_PROFILE entry to load all tools,",
    "or set it to one of the profiles listed in README.md."
  ],
  "mcpServers": {
    "legal-it": {
      "command": "uv",
      "args": ["run", "--frozen", "--python", "3.12", "--project", "plugin/server",
               "python", "plugin/server/run_server.py"]
    },
    "legal-it-privacy": {
      "command": "uv",
      "args": ["run", "--frozen", "--python", "3.12", "--project", "plugin/server",
               "python", "plugin/server/run_server.py"],
      "env": {
        "LEGAL_PROFILE": "privacy"
      }
    }
  }
}
